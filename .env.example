# ───────────────────────────────────────────────────────────
# ApplyTrack environment variables (backend)
# Copy to backend/.env for local dev, or set these on your host.
# ───────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Single-user login gate (pick a strong password)
LOGIN_PASSWORD=change-me
# Secret used to sign the session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives. On Render, point this at the persistent disk,
# e.g. /var/data/applytrack.sqlite
DATABASE_PATH=./data/applytrack.sqlite

# ── Claude / Anthropic (from https://platform.claude.com/workspaces) ──
ANTHROPIC_API_KEY=sk-ant-...
# Model used for extraction, scoring and kit generation
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Job sources ──
# Remotive & RemoteOK need no key. Adzuna is free: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_KEY=

# ── Daily digest email (optional but recommended) ──
# Use a Gmail App Password, or any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
DIGEST_TO=dhirajbhagatcc@gmail.com

# Cron schedule for daily sourcing (default 07:00 daily). Standard cron syntax.
DAILY_CRON=0 7 * * *
# Public URL of the app, used in digest email links
APP_URL=http://localhost:4000
